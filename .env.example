# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=tarihKulubu

# Authentication
JWT_SECRET=your-jwt-secret-here
CRON_SECRET=your-cron-secret-here

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# ImageKit
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM=msfltarihkulubu@outlook.com

# Admin Panel
ADMIN_PASSWORD=change-me-in-production
# Optional: required admin username when set
# ADMIN_USERNAME=admin

# Application
# Not: NODE_ENV'i kendiniz set etmeyin; platform otomatik yönetir.
# Public site URL used in password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

